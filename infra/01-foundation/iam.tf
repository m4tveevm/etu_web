resource "yandex_iam_service_account" "gate" {
  folder_id   = var.folder_id
  name        = "${var.name_prefix}-gate"
  description = "Authenticated static serving and private quote invocation."
}

resource "yandex_iam_service_account" "gateway" {
  folder_id   = var.folder_id
  name        = "${var.name_prefix}-gateway"
  description = "API Gateway invocation of the private gate function only."
}

resource "yandex_iam_service_account" "quote" {
  folder_id   = var.folder_id
  name        = "${var.name_prefix}-quote"
  description = "Quote function runtime, without access to site files or login secrets."
}

resource "yandex_iam_service_account" "release" {
  folder_id   = var.folder_id
  name        = "${var.name_prefix}-release"
  description = "Upload versioned site artifacts. No IAM administration."
}

# Function invocation and version-management roles require their real IDs.
# They belong to 02-release, not to folder-wide bindings here.
# No service-account keys or credential payloads are generated by this stage.
